# === Banco de dados (Supabase / Postgres) ===
# Connection string do Supabase (Settings > Database > Connection string > URI)
# Use a pooled connection (porta 6543, pgbouncer) para a aplicação em runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
# Connection direta (porta 5432) usada pelas migrations do Prisma
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres"

# === Supabase (Auth / API) ===
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# === Backend ===
PORT=3333
NODE_ENV=development
JWT_SECRET=""

# === Frontend ===
NEXT_PUBLIC_API_URL="http://localhost:3333"
